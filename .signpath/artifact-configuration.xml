<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for release.yml. Paste this into the project's artifact
  configuration on signpath.io. The workflow uploads both exes as one GitHub artifact, which
  arrives as a zip with the exes at its root.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="wireless-battery-tray.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="wbt.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
